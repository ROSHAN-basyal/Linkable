QMainWindow, QWidget {
    background: #f5f2ea;
    color: #18201f;
    font-size: 14px;
}

QScrollArea {
    background: transparent;
    border: 0;
}

QLabel#HeroTitle {
    color: #10231f;
    font-size: 32px;
    font-weight: 900;
}

QLabel#InfoText {
    color: #52615d;
    line-height: 140%;
}

QLabel#SectionLabel {
    color: #0f766e;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 6px;
}

QLabel#StatusChip {
    border-radius: 14px;
    padding: 7px 14px;
    background: #dff7ea;
    color: #065f46;
    font-weight: 800;
}

QGroupBox {
    border: 1px solid #d5d0c4;
    border-radius: 18px;
    margin-top: 16px;
    padding: 16px;
    background: #fffaf0;
}

QGroupBox::title {
    color: #0f766e;
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    font-weight: 900;
}

QPushButton {
    background: #0f766e;
    color: #fffaf0;
    border: 0;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 800;
}

QPushButton:hover {
    background: #115e59;
}

QPushButton:disabled {
    background: #d8d3c7;
    color: #8a8375;
}

QPushButton#DangerButton {
    background: #b42318;
    color: #fff7ed;
}

QToolButton {
    background: #e6f4ef;
    color: #10231f;
    border: 1px solid #c7ded6;
    border-radius: 16px;
    padding: 10px;
    font-weight: 800;
}

QToolButton:hover {
    background: #c9eee0;
    border-color: #0f766e;
}

QLineEdit, QTextEdit, QListWidget {
    background: #fffdf7;
    border: 1px solid #d5d0c4;
    border-radius: 12px;
    padding: 8px;
    color: #18201f;
    selection-background-color: #99f6e4;
}

QTextEdit {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}

QSplitter#MainSplitter::handle {
    background: #e1ddd2;
    border-radius: 5px;
    margin: 4px;
}

QSplitter#MainSplitter::handle:hover {
    background: #0f766e;
}
